# Copie ce fichier en .env.local pour régler le back-office sans toucher au code.
# Seules les variables qui commencent par VITE_ sont lues.

# Adresse de l'API (par défaut : la production).
# VITE_API_URL=http://localhost:3000/api

# api = vraies données, demo = données simulées dans le navigateur.
# Par défaut : demo sur localhost, api une fois publié.
# VITE_ADMIN_MODE=api
